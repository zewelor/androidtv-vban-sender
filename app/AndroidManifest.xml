<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="app.vbansender"
    android:versionCode="5" android:versionName="0.5">
    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="31" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="VBAN" android:allowBackup="false"
        android:icon="@android:drawable/ic_lock_silent_mode_off"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name="app.vbansender.app.MainActivity" android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="app.vbansender.app.SettingsActivity" android:exported="false" />
        <activity android:name="app.vbansender.app.ProofActivity" android:exported="true"
            android:launchMode="singleTask" />
        <receiver android:name="app.vbansender.app.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver android:name="app.vbansender.app.ProofBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <service android:name="app.vbansender.app.ProofService" android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service android:name="app.vbansender.app.VbanService" android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
